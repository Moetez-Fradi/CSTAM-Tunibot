<?xml version="1.0" encoding="UTF-8" ?>
<CycloneDDS xmlns="https://cdds.io/config">
    <Domain id="any">
        <General>
            <Network>
                <!-- Fragmentation helps with WiFi packet loss -->
                <FragmentSize>1200</FragmentSize>
                <MaxMessageSize>65500</MaxMessageSize>
            </Network>
            <AllowMulticast>true</AllowMulticast>
        </General>
        <Discovery>
            <!-- Relaxed timing for discovery to reduce flooding -->
            <ParticipantIndex>auto</ParticipantIndex>
            <MaxAutoParticipantIndex>120</MaxAutoParticipantIndex>
            <SPDPHistoryLength>16</SPDPHistoryLength>
        </Discovery>
        <Internal>
            <!-- Increase watermark to handle bursty traffic like Video/Lidar -->
            <MinimumSocketReceiveBufferSize>10MB</MinimumSocketReceiveBufferSize>
            <Watermarks>
                <WhcHigh>500kB</WhcHigh>
            </Watermarks>
        </Internal>
    </Domain>
</CycloneDDS>
