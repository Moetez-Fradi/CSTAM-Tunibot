<?xml version="1.0"?>
<sdf version="1.7">
  <model name="restaurant">
    <!--
      Sweet Home 3D OBJ axes: X horizontal, Y vertical, Z horizontal.
      Gazebo axes: X/Y horizontal, Z vertical.  Rotate +90 degrees about X
      and translate the 40.51 m x 50.00 m export so its ground is centred.
    -->
    <pose>-14.115 17.000 0 1.57079632679 0 0</pose>
    <static>true</static>
    <link name="restaurant_shell">
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>meshes/restaurant.obj</uri>
            <scale>0.01 0.01 0.01</scale>
          </mesh>
        </geometry>
        <!-- The export referenced a missing test.mtl, so use a neutral fallback. -->
        <material>
          <ambient>0.72 0.66 0.56 1</ambient>
          <diffuse>0.82 0.76 0.64 1</diffuse>
          <specular>0.08 0.08 0.08 1</specular>
        </material>
      </visual>
    </link>
  </model>
</sdf>
