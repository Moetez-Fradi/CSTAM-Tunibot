<?xml version="1.0"?>
<!--
  Restaurant scene for Gazebo Fortress / ignition-gazebo6.
  The elevator uses an SDF actor trajectory. Pedestrians are spawned at
  runtime by cstam_phase1/pedestrian_simulator.
-->
<sdf version="1.7">
  <world name="restaurant">
    <physics name="1ms" type="ignored">
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>

    <plugin name="ignition::gazebo::systems::Physics" filename="libignition-gazebo-physics-system.so"/>
    <plugin name="ignition::gazebo::systems::UserCommands" filename="libignition-gazebo-user-commands-system.so"/>
    <plugin name="gz::sim::systems::Contact" filename="gz-sim-contact-system"/>
    <plugin name="ignition::gazebo::systems::SceneBroadcaster" filename="libignition-gazebo-scene-broadcaster-system.so"/>
    <!-- Required to activate sensors attached to spawned models. -->
    <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system">
      <render_engine>ogre2</render_engine>
    </plugin>
    <scene>
      <ambient>0.42 0.42 0.42 1</ambient>
      <background>0.12 0.14 0.18 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <light name="sun" type="directional">
      <pose>0 0 12 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.82 0.82 0.78 1</diffuse>
      <specular>0.15 0.15 0.15 1</specular>
      <direction>-0.35 0.25 -0.90</direction>
    </light>
    <light name="dining_room_light" type="point">
      <pose>10 0 4.7 0 0 0</pose>
      <diffuse>1 0.82 0.60 1</diffuse>
      <specular>0.2 0.16 0.12 1</specular>
      <attenuation><range>25</range><constant>0.4</constant><linear>0.08</linear><quadratic>0.01</quadratic></attenuation>
    </light>
    <light name="upstairs_light" type="point">
      <pose>10 -12 4.5 0 0 0</pose>
      <diffuse>0.80 0.88 1 1</diffuse>
      <specular>0.16 0.18 0.2 1</specular>
      <attenuation><range>22</range><constant>0.4</constant><linear>0.08</linear><quadratic>0.01</quadratic></attenuation>
    </light>

    <!-- Stable physics floor.  The Sweet Home OBJ is a self-intersecting
         visual mesh, so using it directly as collision geometry overwhelms
         ODE with triangle-on-triangle contacts. -->
    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry><plane><normal>0 0 1</normal><size>60 60</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
      </link>
    </model>

    <include><uri>model://restaurant</uri></include>
    <include><uri>model://restaurant_collision</uri></include>

    <!-- A visual reference marker for the two-floor elevator shaft. -->
    <!-- <model name="elevator_shaft">
      <static>true</static>
      <pose>12 -5 0.35 0 0 0</pose>
      <link name="shaft_link">
        <visual name="left_guide"><pose>-0.9 0 1.5 0 0 0</pose><geometry><box><size>0.10 1.8 3.2</size></box></geometry><material><diffuse>0.18 0.20 0.24 1</diffuse></material></visual>
        <visual name="right_guide"><pose>0.9 0 1.5 0 0 0</pose><geometry><box><size>0.10 1.8 3.2</size></box></geometry><material><diffuse>0.18 0.20 0.24 1</diffuse></material></visual>
        <visual name="lintel"><pose>0 0 3.05 0 0 0</pose><geometry><box><size>1.9 1.8 0.12</size></box></geometry><material><diffuse>0.18 0.20 0.24 1</diffuse></material></visual>
      </link>
    </model> -->

    <!--
      Both Y sides are open: board from Y=- and exit from Y=+ (or reverse).
      Lower-floor dwell (0-12 s), travel up (12-16 s), upper-floor dwell
      (16-28 s), travel down (28-32 s). The cycle repeats every 32 s.
    -->
    <actor name="restaurant_elevator">
      <link name="cabin">
        <collision name="platform_collision"><pose>0 0 0.08 0 0 0</pose><geometry><box><size>1.6 1.5 0.16</size></box></geometry></collision>
        <collision name="left_wall_collision"><pose>-0.75 0 0.85 0 0 0</pose><geometry><box><size>0.10 1.5 1.7</size></box></geometry></collision>
        <collision name="right_wall_collision"><pose>0.75 0 0.85 0 0 0</pose><geometry><box><size>0.10 1.5 1.7</size></box></geometry></collision>
        <visual name="platform"><pose>0 0 0.08 0 0 0</pose><geometry><box><size>1.6 1.5 0.16</size></box></geometry><material><diffuse>0.22 0.24 0.29 1</diffuse></material></visual>
        <visual name="left_wall"><pose>-0.75 0 0.85 0 0 0</pose><geometry><box><size>0.10 1.5 1.7</size></box></geometry><material><diffuse>0.52 0.56 0.63 1</diffuse></material></visual>
        <visual name="right_wall"><pose>0.75 0 0.85 0 0 0</pose><geometry><box><size>0.10 1.5 1.7</size></box></geometry><material><diffuse>0.52 0.56 0.63 1</diffuse></material></visual>
      </link>
      <script>
        <loop>true</loop><delay_start>2</delay_start><auto_start>true</auto_start>
        <trajectory id="0" type="elevator_cycle">
          <waypoint><time>0</time><pose>12 -5 0.35 0 0 0</pose></waypoint>
          <waypoint><time>12</time><pose>12 -5 0.35 0 0 0</pose></waypoint>
          <waypoint><time>16</time><pose>12 -5 2.25 0 0 0</pose></waypoint>
          <waypoint><time>28</time><pose>12 -5 2.25 0 0 0</pose></waypoint>
          <waypoint><time>32</time><pose>12 -5 0.35 0 0 0</pose></waypoint>
        </trajectory>
      </script>
    </actor>

    <!-- Diners are no longer scripted actors here. cstam_phase1's
         pedestrian_simulator spawns scenario-driven people at runtime
         (config/pedestrians.yaml) that react to the robot and are
         measured against ground truth. -->
  </world>
</sdf>
