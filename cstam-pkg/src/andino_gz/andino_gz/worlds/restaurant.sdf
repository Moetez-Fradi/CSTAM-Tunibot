<?xml version="1.0"?>
<!--
  Restaurant scene for Gazebo Fortress / ignition-gazebo6.
  Pedestrians and the elevator use SDF actor trajectories, which run without
  a custom plugin, ROS node, or network asset.  Their paths are visual and
  collision-aware obstacles, but are intentionally kinematic (they do not
  carry a robot or react to collisions).
-->
<sdf version="1.7">
  <world name="restaurant">
    <physics name="1ms" type="ignored">
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>

    <plugin name="ignition::gazebo::systems::Physics" filename="libignition-gazebo-physics-system.so"/>
    <plugin name="ignition::gazebo::systems::UserCommands" filename="libignition-gazebo-user-commands-system.so"/>
    <plugin name="gz::sim::systems::Contact" filename="gz-sim-contact-system"/>
    <plugin name="ignition::gazebo::systems::SceneBroadcaster" filename="libignition-gazebo-scene-broadcaster-system.so"/>
    <!-- Required to activate sensors attached to spawned models. -->
    <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system">
      <render_engine>ogre2</render_engine>
    </plugin>
    <scene>
      <ambient>0.42 0.42 0.42 1</ambient>
      <background>0.12 0.14 0.18 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <light name="sun" type="directional">
      <pose>0 0 12 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.82 0.82 0.78 1</diffuse>
      <specular>0.15 0.15 0.15 1</specular>
      <direction>-0.35 0.25 -0.90</direction>
    </light>
    <light name="dining_room_light" type="point">
      <pose>10 0 4.7 0 0 0</pose>
      <diffuse>1 0.82 0.60 1</diffuse>
      <specular>0.2 0.16 0.12 1</specular>
      <attenuation><range>25</range><constant>0.4</constant><linear>0.08</linear><quadratic>0.01</quadratic></attenuation>
    </light>
    <light name="upstairs_light" type="point">
      <pose>10 -12 4.5 0 0 0</pose>
      <diffuse>0.80 0.88 1 1</diffuse>
      <specular>0.16 0.18 0.2 1</specular>
      <attenuation><range>22</range><constant>0.4</constant><linear>0.08</linear><quadratic>0.01</quadratic></attenuation>
    </light>

    <!-- Stable physics floor.  The Sweet Home OBJ is a self-intersecting
         visual mesh, so using it directly as collision geometry overwhelms
         ODE with triangle-on-triangle contacts. -->
    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry><plane><normal>0 0 1</normal><size>60 60</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
      </link>
    </model>

    <include><uri>model://restaurant</uri></include>
    <include><uri>model://restaurant_collision</uri></include>

    <!-- A visual reference marker for the two-floor elevator shaft. -->
    <!-- <model name="elevator_shaft">
      <static>true</static>
      <pose>12 -5 0.35 0 0 0</pose>
      <link name="shaft_link">
        <visual name="left_guide"><pose>-0.9 0 1.5 0 0 0</pose><geometry><box><size>0.10 1.8 3.2</size></box></geometry><material><diffuse>0.18 0.20 0.24 1</diffuse></material></visual>
        <visual name="right_guide"><pose>0.9 0 1.5 0 0 0</pose><geometry><box><size>0.10 1.8 3.2</size></box></geometry><material><diffuse>0.18 0.20 0.24 1</diffuse></material></visual>
        <visual name="lintel"><pose>0 0 3.05 0 0 0</pose><geometry><box><size>1.9 1.8 0.12</size></box></geometry><material><diffuse>0.18 0.20 0.24 1</diffuse></material></visual>
      </link>
    </model> -->

    <!--
      Both Y sides are open: board from Y=- and exit from Y=+ (or reverse).
      Lower-floor dwell (0-12 s), travel up (12-16 s), upper-floor dwell
      (16-28 s), travel down (28-32 s). The cycle repeats every 32 s.
    -->
    <actor name="restaurant_elevator">
      <link name="cabin">
        <collision name="platform_collision"><pose>0 0 0.08 0 0 0</pose><geometry><box><size>1.6 1.5 0.16</size></box></geometry></collision>
        <collision name="left_wall_collision"><pose>-0.75 0 0.85 0 0 0</pose><geometry><box><size>0.10 1.5 1.7</size></box></geometry></collision>
        <collision name="right_wall_collision"><pose>0.75 0 0.85 0 0 0</pose><geometry><box><size>0.10 1.5 1.7</size></box></geometry></collision>
        <visual name="platform"><pose>0 0 0.08 0 0 0</pose><geometry><box><size>1.6 1.5 0.16</size></box></geometry><material><diffuse>0.22 0.24 0.29 1</diffuse></material></visual>
        <visual name="left_wall"><pose>-0.75 0 0.85 0 0 0</pose><geometry><box><size>0.10 1.5 1.7</size></box></geometry><material><diffuse>0.52 0.56 0.63 1</diffuse></material></visual>
        <visual name="right_wall"><pose>0.75 0 0.85 0 0 0</pose><geometry><box><size>0.10 1.5 1.7</size></box></geometry><material><diffuse>0.52 0.56 0.63 1</diffuse></material></visual>
      </link>
      <script>
        <loop>true</loop><delay_start>2</delay_start><auto_start>true</auto_start>
        <trajectory id="0" type="elevator_cycle">
          <waypoint><time>0</time><pose>12 -5 0.35 0 0 0</pose></waypoint>
          <waypoint><time>12</time><pose>12 -5 0.35 0 0 0</pose></waypoint>
          <waypoint><time>16</time><pose>12 -5 2.25 0 0 0</pose></waypoint>
          <waypoint><time>28</time><pose>12 -5 2.25 0 0 0</pose></waypoint>
          <waypoint><time>32</time><pose>12 -5 0.35 0 0 0</pose></waypoint>
        </trajectory>
      </script>
    </actor>

    <!-- A simple articulated-looking actor made from primitives, kept local and offline. -->
    <actor name="diner_ada">
      <link name="person_link">
        <visual name="body"><pose>0 0 0.95 0 0 0</pose><geometry><cylinder><radius>0.22</radius><length>1.10</length></cylinder></geometry><material><diffuse>0.10 0.38 0.72 1</diffuse></material></visual>
        <visual name="head"><pose>0 0 1.67 0 0 0</pose><geometry><sphere><radius>0.19</radius></sphere></geometry><material><diffuse>0.72 0.45 0.28 1</diffuse></material></visual>
        <visual name="left_leg"><pose>-0.11 0 0.30 0 0 0</pose><geometry><box><size>0.12 0.14 0.60</size></box></geometry><material><diffuse>0.08 0.09 0.12 1</diffuse></material></visual>
        <visual name="right_leg"><pose>0.11 0 0.30 0 0 0</pose><geometry><box><size>0.12 0.14 0.60</size></box></geometry><material><diffuse>0.08 0.09 0.12 1</diffuse></material></visual>
      </link>
      <script>
        <loop>true</loop><auto_start>true</auto_start>
        <!-- seated at table (0-10), rises, walks a perimeter route, returns and sits -->
        <trajectory id="0" type="diner_cycle">
          <waypoint><time>0</time><pose>6.25 11.10 -0.35 0 0 0</pose></waypoint>
          <waypoint><time>10</time><pose>6.25 11.10 -0.35 0 0 0</pose></waypoint>
          <waypoint><time>12</time><pose>6.25 11.10 0 0 0 -1.57</pose></waypoint>
          <waypoint><time>17</time><pose>5.40 8.20 0 0 0 -1.57</pose></waypoint>
          <waypoint><time>23</time><pose>8.20 6.30 0 0 0 0.55</pose></waypoint>
          <waypoint><time>29</time><pose>11.10 8.20 0 0 0 1.57</pose></waypoint>
          <waypoint><time>35</time><pose>6.25 11.10 -0.35 0 0 3.14</pose></waypoint>
          <waypoint><time>43</time><pose>6.25 11.10 -0.35 0 0 3.14</pose></waypoint>
        </trajectory>
      </script>
    </actor>

    <actor name="diner_sami">
      <link name="person_link">
        <visual name="body"><pose>0 0 0.95 0 0 0</pose><geometry><cylinder><radius>0.22</radius><length>1.10</length></cylinder></geometry><material><diffuse>0.70 0.19 0.18 1</diffuse></material></visual>
        <visual name="head"><pose>0 0 1.67 0 0 0</pose><geometry><sphere><radius>0.19</radius></sphere></geometry><material><diffuse>0.36 0.21 0.12 1</diffuse></material></visual>
        <visual name="left_leg"><pose>-0.11 0 0.30 0 0 0</pose><geometry><box><size>0.12 0.14 0.60</size></box></geometry><material><diffuse>0.10 0.11 0.14 1</diffuse></material></visual>
        <visual name="right_leg"><pose>0.11 0 0.30 0 0 0</pose><geometry><box><size>0.12 0.14 0.60</size></box></geometry><material><diffuse>0.10 0.11 0.14 1</diffuse></material></visual>
      </link>
      <script>
        <loop>true</loop><delay_start>16</delay_start><auto_start>true</auto_start>
        <!-- opposite side of the table, with a staggered route -->
        <trajectory id="0" type="diner_cycle">
          <waypoint><time>0</time><pose>7.95 11.10 -0.35 0 0 3.14</pose></waypoint>
          <waypoint><time>12</time><pose>7.95 11.10 -0.35 0 0 3.14</pose></waypoint>
          <waypoint><time>14</time><pose>7.95 11.10 0 0 0 -1.57</pose></waypoint>
          <waypoint><time>19</time><pose>10.90 10.10 0 0 0 -0.20</pose></waypoint>
          <waypoint><time>25</time><pose>12.70 6.20 0 0 0 -1.57</pose></waypoint>
          <waypoint><time>31</time><pose>9.70 4.90 0 0 0 2.80</pose></waypoint>
          <waypoint><time>38</time><pose>7.95 11.10 -0.35 0 0 1.57</pose></waypoint>
          <waypoint><time>46</time><pose>7.95 11.10 -0.35 0 0 1.57</pose></waypoint>
        </trajectory>
      </script>
    </actor>

    <actor name="diner_noor">
      <link name="person_link">
        <visual name="body"><pose>0 0 0.95 0 0 0</pose><geometry><cylinder><radius>0.22</radius><length>1.10</length></cylinder></geometry><material><diffuse>0.19 0.60 0.34 1</diffuse></material></visual>
        <visual name="head"><pose>0 0 1.67 0 0 0</pose><geometry><sphere><radius>0.19</radius></sphere></geometry><material><diffuse>0.56 0.32 0.18 1</diffuse></material></visual>
        <visual name="left_leg"><pose>-0.11 0 0.30 0 0 0</pose><geometry><box><size>0.12 0.14 0.60</size></box></geometry><material><diffuse>0.12 0.12 0.13 1</diffuse></material></visual>
        <visual name="right_leg"><pose>0.11 0 0.30 0 0 0</pose><geometry><box><size>0.12 0.14 0.60</size></box></geometry><material><diffuse>0.12 0.12 0.13 1</diffuse></material></visual>
      </link>
      <script>
        <loop>true</loop><delay_start>29</delay_start><auto_start>true</auto_start>
        <trajectory id="0" type="diner_cycle">
          <waypoint><time>0</time><pose>7.10 12.75 -0.35 0 0 -1.57</pose></waypoint>
          <waypoint><time>9</time><pose>7.10 12.75 -0.35 0 0 -1.57</pose></waypoint>
          <waypoint><time>12</time><pose>7.10 12.75 0 0 0 0</pose></waypoint>
          <waypoint><time>18</time><pose>3.80 10.80 0 0 0 -2.65</pose></waypoint>
          <waypoint><time>25</time><pose>3.90 6.10 0 0 0 -1.57</pose></waypoint>
          <waypoint><time>32</time><pose>7.10 12.75 -0.35 0 0 0.75</pose></waypoint>
          <waypoint><time>41</time><pose>7.10 12.75 -0.35 0 0 0.75</pose></waypoint>
        </trajectory>
      </script>
    </actor>
  </world>
</sdf>
