<?xml version="1.0"?>
<!--
  Restaurant scene for Gazebo Fortress / ignition-gazebo6.
  The elevator cabin is moved by cstam_phase1/elevator. Pedestrians are spawned at
  runtime by cstam_phase1/pedestrian_simulator.
-->
<sdf version="1.7">
  <world name="restaurant">
    <physics name="1ms" type="ignored">
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>

    <plugin name="ignition::gazebo::systems::Physics" filename="libignition-gazebo-physics-system.so"/>
    <plugin name="ignition::gazebo::systems::UserCommands" filename="libignition-gazebo-user-commands-system.so"/>
    <plugin name="gz::sim::systems::Contact" filename="gz-sim-contact-system"/>
    <plugin name="ignition::gazebo::systems::SceneBroadcaster" filename="libignition-gazebo-scene-broadcaster-system.so"/>
    <!-- Required to activate sensors attached to spawned models. -->
    <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system">
      <render_engine>ogre2</render_engine>
    </plugin>
    <scene>
      <ambient>0.42 0.42 0.42 1</ambient>
      <background>0.12 0.14 0.18 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <light name="sun" type="directional">
      <pose>0 0 12 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.82 0.82 0.78 1</diffuse>
      <specular>0.15 0.15 0.15 1</specular>
      <direction>-0.35 0.25 -0.90</direction>
    </light>
    <light name="dining_room_light" type="point">
      <pose>10 0 4.7 0 0 0</pose>
      <diffuse>1 0.82 0.60 1</diffuse>
      <specular>0.2 0.16 0.12 1</specular>
      <attenuation><range>25</range><constant>0.4</constant><linear>0.08</linear><quadratic>0.01</quadratic></attenuation>
    </light>
    <light name="upstairs_light" type="point">
      <pose>10 -12 4.5 0 0 0</pose>
      <diffuse>0.80 0.88 1 1</diffuse>
      <specular>0.16 0.18 0.2 1</specular>
      <attenuation><range>22</range><constant>0.4</constant><linear>0.08</linear><quadratic>0.01</quadratic></attenuation>
    </light>

    <!-- Stable physics floor.  The Sweet Home OBJ is a self-intersecting
         visual mesh, so using it directly as collision geometry overwhelms
         ODE with triangle-on-triangle contacts. -->
    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry><plane><normal>0 0 1</normal><size>60 60</size></plane></geometry>
          <!-- 0x01: everything but the elevator platform (0x02), which sits flush in it. -->
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
            <contact><collide_bitmask>0x01</collide_bitmask></contact>
          </surface>
        </collision>
      </link>
    </model>

    <include><uri>model://restaurant</uri></include>
    <include><uri>model://restaurant_collision</uri></include>
    <!-- Terrace furniture collision, generated from the mesh by
         cstam_phase1/scripts/build_terrace.py. -->
    <include><uri>model://terrace_collision</uri></include>
    <!-- Upper dining room floor slab, generated by
         cstam_phase1/scripts/build_upper_floor.py. -->
    <include><uri>model://upper_floor_collision</uri></include>

    <!--
      Visual-only table-number plaques.  The restaurant came from a single
      Sweet Home mesh, so its tables have no useful individual visual names.
      These small seven-segment markers sit on the tabletops the semantic targets
      (table_1, table_2 and table_3: west column, north to south) serve, while
      deliberately adding no collision geometry or sensor returns.  Their
      poses use Gazebo world coordinates (map coordinates + 11.22, +6.95).
    -->
    <model name="table_number_plaques">
      <static>true</static>

      <!-- Table 1: a dark tabletop plaque with a bright "1". -->
      <link name="table_1_plaque">
        <pose>7.11 11.10 0.76 0 0 -1.5708</pose>
        <visual name="backing"><geometry><box><size>0.46 0.32 0.018</size></box></geometry><material><ambient>0.05 0.07 0.10 1</ambient><diffuse>0.05 0.07 0.10 1</diffuse></material></visual>
        <visual name="one_upper"><pose>0.07 0.045 0.030 0 0 0</pose><geometry><box><size>0.035 0.115 0.012</size></box></geometry><material><emissive>1 0.78 0.18 1</emissive><diffuse>1 0.78 0.18 1</diffuse></material></visual>
        <visual name="one_lower"><pose>0.07 -0.045 0.030 0 0 0</pose><geometry><box><size>0.035 0.115 0.012</size></box></geometry><material><emissive>1 0.78 0.18 1</emissive><diffuse>1 0.78 0.18 1</diffuse></material></visual>
      </link>

      <!-- Table 2: seven-segment "2". -->
      <link name="table_2_plaque">
        <pose>7.13 8.94 0.76 0 0 -1.5708</pose>
        <visual name="backing"><geometry><box><size>0.46 0.32 0.018</size></box></geometry><material><ambient>0.05 0.07 0.10 1</ambient><diffuse>0.05 0.07 0.10 1</diffuse></material></visual>
        <visual name="top"><pose>0 0.09 0.018 0 0 0</pose><geometry><box><size>0.15 0.035 0.012</size></box></geometry><material><emissive>0.25 0.85 1 1</emissive><diffuse>0.25 0.85 1 1</diffuse></material></visual>
        <visual name="upper_right"><pose>0.075 0.045 0.030 0 0 0</pose><geometry><box><size>0.035 0.115 0.012</size></box></geometry><material><emissive>0.25 0.85 1 1</emissive><diffuse>0.25 0.85 1 1</diffuse></material></visual>
        <visual name="middle"><pose>0 0 0.030 0 0 0</pose><geometry><box><size>0.15 0.035 0.012</size></box></geometry><material><emissive>0.25 0.85 1 1</emissive><diffuse>0.25 0.85 1 1</diffuse></material></visual>
        <visual name="lower_left"><pose>-0.075 -0.045 0.030 0 0 0</pose><geometry><box><size>0.035 0.115 0.012</size></box></geometry><material><emissive>0.25 0.85 1 1</emissive><diffuse>0.25 0.85 1 1</diffuse></material></visual>
        <visual name="bottom"><pose>0 -0.09 0.030 0 0 0</pose><geometry><box><size>0.15 0.035 0.012</size></box></geometry><material><emissive>0.25 0.85 1 1</emissive><diffuse>0.25 0.85 1 1</diffuse></material></visual>
      </link>

      <!-- Table 3: seven-segment "3". -->
      <link name="table_3_plaque">
        <pose>7.08 4.65 0.76 0 0 -1.5708</pose>
        <visual name="backing"><geometry><box><size>0.46 0.32 0.018</size></box></geometry><material><ambient>0.05 0.07 0.10 1</ambient><diffuse>0.05 0.07 0.10 1</diffuse></material></visual>
        <visual name="top"><pose>0 0.09 0.018 0 0 0</pose><geometry><box><size>0.15 0.035 0.012</size></box></geometry><material><emissive>1 0.36 0.30 1</emissive><diffuse>1 0.36 0.30 1</diffuse></material></visual>
        <visual name="upper_right"><pose>0.075 0.045 0.030 0 0 0</pose><geometry><box><size>0.035 0.115 0.012</size></box></geometry><material><emissive>1 0.36 0.30 1</emissive><diffuse>1 0.36 0.30 1</diffuse></material></visual>
        <visual name="middle"><pose>0 0 0.030 0 0 0</pose><geometry><box><size>0.15 0.035 0.012</size></box></geometry><material><emissive>1 0.36 0.30 1</emissive><diffuse>1 0.36 0.30 1</diffuse></material></visual>
        <visual name="lower_right"><pose>0.075 -0.045 0.030 0 0 0</pose><geometry><box><size>0.035 0.115 0.012</size></box></geometry><material><emissive>1 0.36 0.30 1</emissive><diffuse>1 0.36 0.30 1</diffuse></material></visual>
        <visual name="bottom"><pose>0 -0.09 0.030 0 0 0</pose><geometry><box><size>0.15 0.035 0.012</size></box></geometry><material><emissive>1 0.36 0.30 1</emissive><diffuse>1 0.36 0.30 1</diffuse></material></visual>
      </link>

      <!-- Table 4 (upstairs): seven-segment "4". -->
      <link name="table_4_plaque">
        <pose>7.07 -10.07 3.31 0 0 -1.5708</pose>
        <visual name="backing"><geometry><box><size>0.46 0.32 0.018</size></box></geometry><material><ambient>0.05 0.07 0.10 1</ambient><diffuse>0.05 0.07 0.10 1</diffuse></material></visual>
        <visual name="upper_left"><pose>-0.075 0.045 0.030 0 0 0</pose><geometry><box><size>0.035 0.115 0.012</size></box></geometry><material><emissive>0.35 1 0.5 1</emissive><diffuse>0.35 1 0.5 1</diffuse></material></visual>
        <visual name="upper_right"><pose>0.075 0.045 0.030 0 0 0</pose><geometry><box><size>0.035 0.115 0.012</size></box></geometry><material><emissive>0.35 1 0.5 1</emissive><diffuse>0.35 1 0.5 1</diffuse></material></visual>
        <visual name="middle"><pose>0 0 0.030 0 0 0</pose><geometry><box><size>0.15 0.035 0.012</size></box></geometry><material><emissive>0.35 1 0.5 1</emissive><diffuse>0.35 1 0.5 1</diffuse></material></visual>
        <visual name="lower_right"><pose>0.075 -0.045 0.030 0 0 0</pose><geometry><box><size>0.035 0.115 0.012</size></box></geometry><material><emissive>0.35 1 0.5 1</emissive><diffuse>0.35 1 0.5 1</diffuse></material></visual>
      </link>
      <!-- Table 5 (upstairs): seven-segment "5". -->
      <link name="table_5_plaque">
        <pose>7.09 -12.23 3.31 0 0 -1.5708</pose>
        <visual name="backing"><geometry><box><size>0.46 0.32 0.018</size></box></geometry><material><ambient>0.05 0.07 0.10 1</ambient><diffuse>0.05 0.07 0.10 1</diffuse></material></visual>
        <visual name="top"><pose>0 0.09 0.030 0 0 0</pose><geometry><box><size>0.15 0.035 0.012</size></box></geometry><material><emissive>1 0.92 0.6 1</emissive><diffuse>1 0.92 0.6 1</diffuse></material></visual>
        <visual name="upper_left"><pose>-0.075 0.045 0.030 0 0 0</pose><geometry><box><size>0.035 0.115 0.012</size></box></geometry><material><emissive>1 0.92 0.6 1</emissive><diffuse>1 0.92 0.6 1</diffuse></material></visual>
        <visual name="middle"><pose>0 0 0.030 0 0 0</pose><geometry><box><size>0.15 0.035 0.012</size></box></geometry><material><emissive>1 0.92 0.6 1</emissive><diffuse>1 0.92 0.6 1</diffuse></material></visual>
        <visual name="lower_right"><pose>0.075 -0.045 0.030 0 0 0</pose><geometry><box><size>0.035 0.115 0.012</size></box></geometry><material><emissive>1 0.92 0.6 1</emissive><diffuse>1 0.92 0.6 1</diffuse></material></visual>
        <visual name="bottom"><pose>0 -0.09 0.030 0 0 0</pose><geometry><box><size>0.15 0.035 0.012</size></box></geometry><material><emissive>1 0.92 0.6 1</emissive><diffuse>1 0.92 0.6 1</diffuse></material></visual>
      </link>
    </model>

    <!--
      Charging pads at the dock (map 5.78, 15.50, facing the hatch). Visual only
      and 6 mm thin, below the LiDAR floor filter. cstam_phase1's battery
      simulator charges only while the robot stands on them as docked.
    -->
    <model name="charging_pads">
      <static>true</static>
      <pose>17.00 22.45 0.003 0 0 1.5708</pose>
      <link name="pads">
        <visual name="base"><geometry><box><size>0.70 0.62 0.006</size></box></geometry><material><ambient>0.10 0.11 0.13 1</ambient><diffuse>0.10 0.11 0.13 1</diffuse></material></visual>
        <visual name="left_contact"><pose>0.20 0.12 0.001 0 0 0</pose><geometry><box><size>0.20 0.05 0.006</size></box></geometry><material><emissive>0.30 0.90 0.45 1</emissive><diffuse>0.30 0.90 0.45 1</diffuse></material></visual>
        <visual name="right_contact"><pose>0.20 -0.12 0.001 0 0 0</pose><geometry><box><size>0.20 0.05 0.006</size></box></geometry><material><emissive>0.30 0.90 0.45 1</emissive><diffuse>0.30 0.90 0.45 1</diffuse></material></visual>
      </link>
    </model>

    <!--
      Elevator cabin in the restaurant's shaft (map x -0.10..1.92, y -12.64..-10.73;
      doorway north at floor 1, south at floor 2). The platform rides a prismatic
      joint and physically carries the robot: its top is flush with floor 1 at
      lift = 0 and with floor 2 at lift = 2.56. cstam_phase1's elevator node
      drives the joint's velocity (/elevator/lift/cmd_vel) and reads its
      position (/elevator/joint_state). It does not collide with the ground
      plane (collide_bitmask), so it can sit flush in it. World coordinates.
    -->
    <model name="elevator_cabin">
      <pose>12.13 -4.75 0 0 0 0</pose>
      <link name="cabin">
        <inertial><mass>200</mass><inertia><ixx>60</ixx><iyy>60</iyy><izz>100</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="platform">
          <pose>0 0 -0.03 0 0 0</pose>
          <geometry><box><size>1.86 1.74 0.06</size></box></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
            <contact><collide_bitmask>0x02</collide_bitmask></contact>
          </surface>
        </collision>
        <visual name="platform"><pose>0 0 -0.03 0 0 0</pose><geometry><box><size>1.86 1.74 0.06</size></box></geometry><material><ambient>0.22 0.24 0.29 1</ambient><diffuse>0.22 0.24 0.29 1</diffuse></material></visual>
        <visual name="west_panel"><pose>-0.89 0 0.53 0 0 0</pose><geometry><box><size>0.04 1.60 1.06</size></box></geometry><material><ambient>0.52 0.56 0.63 1</ambient><diffuse>0.52 0.56 0.63 1</diffuse></material></visual>
        <visual name="east_panel"><pose>0.89 0 0.53 0 0 0</pose><geometry><box><size>0.04 1.60 1.06</size></box></geometry><material><ambient>0.52 0.56 0.63 1</ambient><diffuse>0.52 0.56 0.63 1</diffuse></material></visual>
      </link>
      <joint name="lift" type="prismatic">
        <parent>world</parent>
        <child>cabin</child>
        <axis>
          <xyz>0 0 1</xyz>
          <!-- Margins past both floors: a velocity command at exactly a limit
               does nothing in DART. The elevator node stops at the floors. -->
          <limit><lower>-0.05</lower><upper>2.65</upper><effort>1e6</effort><velocity>1.0</velocity></limit>
        </axis>
      </joint>
      <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
        <joint_name>lift</joint_name>
        <topic>/elevator/lift/cmd_vel</topic>
        <initial_velocity>0.0</initial_velocity>
      </plugin>
      <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
        <topic>/elevator/joint_state</topic>
        <joint_name>lift</joint_name>
      </plugin>
    </model>

    <!-- Diners are no longer scripted actors here. cstam_phase1's
         pedestrian_simulator spawns scenario-driven people at runtime
         (config/pedestrians.yaml) that react to the robot and are
         measured against ground truth. -->
  </world>
</sdf>
