Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Map
      Name: Saved restaurant map
      Topic: /map
      Alpha: 0.75
      Color Scheme: map
      Draw Behind: false
      Enabled: true
      QoS Durability Policy: Transient Local
      QoS History Policy: Keep Last
      QoS Reliability Policy: Reliable
    - Class: rviz_default_plugins/RobotModel
      Name: CSTAM
      Robot Description: robot_description
      Enabled: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 0.5
    - Class: rviz_default_plugins/LaserScan
      Name: 3D-derived navigation scan
      Topic: /scan_navigation
      Enabled: true
      Style: Points
      Size (Pixels): 2
      Color: 255; 0; 0
      Decay Time: 0.2
      Use Fixed Frame: true
    - Class: rviz_default_plugins/PointCloud2
      Name: 3D LiDAR cloud
      Topic: /lidar/points_filtered
      Enabled: true
      Style: Points
      Size (Pixels): 2
      Use Fixed Frame: true
    - Class: nav2_rviz_plugins/Costmap
      Name: Global costmap
      Topic: /global_costmap/costmap
      Enabled: true
      Unreliable: false
    - Class: nav2_rviz_plugins/Costmap
      Name: Local costmap
      Topic: /local_costmap/costmap
      Enabled: true
      Unreliable: false
    - Class: nav2_rviz_plugins/Path
      Name: Global plan
      Topic: /plan
      Enabled: true
      Color: 0; 255; 0
      Line Style: Lines
      Line Width: 0.03
    - Class: nav2_rviz_plugins/Path
      Name: Local controller path
      Topic: /local_plan
      Enabled: true
      Color: 255; 255; 0
      Line Style: Lines
      Line Width: 0.03
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: CSTAM Phase 1
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/SetInitialPose
    - Class: rviz_default_plugins/Goal
    - Class: rviz_default_plugins/PublishPoint
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Top-down
      Scale: 75
      X: 0
      Y: 0
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Width: 1400
