<?xml version="1.0"?>
<package format="3">
  <name>cstam_ui</name>
  <version>0.1.0</version>
  <description>Customer ordering and admin monitoring web UI for the CSTAM delivery robot.</description>
  <maintainer email="maintainer@example.com">CSTAM robot team</maintainer>
  <license>MIT</license>

  <buildtool_depend>python3-setuptools</buildtool_depend>

  <exec_depend>cstam_phase1</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
