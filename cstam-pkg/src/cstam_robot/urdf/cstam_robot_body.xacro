<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="cstam_body"
               params="shelf_length shelf_width shelf_thickness shelf_1_z shelf_2_z shelf_3_z shelf_mass mast_z mast_height display_z">
    <link name="rear_panel_link">
      <visual><geometry><box size="0.045 ${shelf_width} 0.83"/></geometry><material name="cstam_light_blue"/></visual>
      <collision><geometry><box size="0.045 ${shelf_width} 0.83"/></geometry></collision>
      <xacro:box_inertia mass="1.1" x="0.045" y="${shelf_width}" z="0.83"/>
    </link>
    <joint name="rear_panel_joint" type="fixed">
      <parent link="base_link"/><child link="rear_panel_link"/>
      <origin xyz="-0.215 0 0.515" rpy="0 0 0"/>
    </joint>

    <!-- Full-height side supports keep all three delivery shelves attached. -->
    <link name="left_shelf_support_link">
      <visual><geometry><box size="${shelf_length} 0.025 0.83"/></geometry><material name="cstam_light_blue"/></visual>
      <collision><geometry><box size="${shelf_length} 0.025 0.83"/></geometry></collision>
      <xacro:box_inertia mass="0.35" x="${shelf_length}" y="0.025" z="0.83"/>
    </link>
    <joint name="left_shelf_support_joint" type="fixed">
      <parent link="base_link"/><child link="left_shelf_support_link"/>
      <origin xyz="0 ${shelf_width / 2.0 - 0.0125} 0.515" rpy="0 0 0"/>
    </joint>

    <link name="right_shelf_support_link">
      <visual><geometry><box size="${shelf_length} 0.025 0.83"/></geometry><material name="cstam_light_blue"/></visual>
      <collision><geometry><box size="${shelf_length} 0.025 0.83"/></geometry></collision>
      <xacro:box_inertia mass="0.35" x="${shelf_length}" y="0.025" z="0.83"/>
    </link>
    <joint name="right_shelf_support_joint" type="fixed">
      <parent link="base_link"/><child link="right_shelf_support_link"/>
      <origin xyz="0 -${shelf_width / 2.0 - 0.0125} 0.515" rpy="0 0 0"/>
    </joint>

    <!-- Each shelf is fixed to the rear panel, which is fixed to the chassis. -->
    <link name="shelf_1_link">
      <visual><geometry><box size="${shelf_length} ${shelf_width} ${shelf_thickness}"/></geometry><material name="shelf_white"/></visual>
      <collision><geometry><box size="${shelf_length} ${shelf_width} ${shelf_thickness}"/></geometry></collision>
      <xacro:box_inertia mass="${shelf_mass}" x="${shelf_length}" y="${shelf_width}" z="${shelf_thickness}"/>
    </link>
    <joint name="shelf_1_joint" type="fixed">
      <parent link="rear_panel_link"/><child link="shelf_1_link"/>
      <origin xyz="0.215 0 ${shelf_1_z - 0.515}" rpy="0 0 0"/>
    </joint>

    <link name="shelf_2_link">
      <visual><geometry><box size="${shelf_length} ${shelf_width} ${shelf_thickness}"/></geometry><material name="shelf_white"/></visual>
      <collision><geometry><box size="${shelf_length} ${shelf_width} ${shelf_thickness}"/></geometry></collision>
      <xacro:box_inertia mass="${shelf_mass}" x="${shelf_length}" y="${shelf_width}" z="${shelf_thickness}"/>
    </link>
    <joint name="shelf_2_joint" type="fixed">
      <parent link="rear_panel_link"/><child link="shelf_2_link"/>
      <origin xyz="0.215 0 ${shelf_2_z - 0.515}" rpy="0 0 0"/>
    </joint>

    <link name="shelf_3_link">
      <visual><geometry><box size="${shelf_length} ${shelf_width} ${shelf_thickness}"/></geometry><material name="shelf_white"/></visual>
      <collision><geometry><box size="${shelf_length} ${shelf_width} ${shelf_thickness}"/></geometry></collision>
      <xacro:box_inertia mass="${shelf_mass}" x="${shelf_length}" y="${shelf_width}" z="${shelf_thickness}"/>
    </link>
    <joint name="shelf_3_joint" type="fixed">
      <parent link="rear_panel_link"/><child link="shelf_3_link"/>
      <origin xyz="0.215 0 ${shelf_3_z - 0.515}" rpy="0 0 0"/>
    </joint>

    <link name="sensor_mast_link">
      <visual><geometry><box size="0.055 0.055 ${mast_height}"/></geometry><material name="cstam_blue"/></visual>
      <collision><geometry><box size="0.055 0.055 ${mast_height}"/></geometry></collision>
      <xacro:box_inertia mass="0.45" x="0.055" y="0.055" z="${mast_height}"/>
    </link>
    <joint name="sensor_mast_joint" type="fixed">
      <parent link="base_link"/><child link="sensor_mast_link"/>
      <origin xyz="0.17 0 ${mast_z}" rpy="0 0 0"/>
    </joint>

    <link name="display_link">
      <visual><geometry><box size="0.045 0.28 0.16"/></geometry><material name="display_green"/></visual>
      <collision><geometry><box size="0.045 0.28 0.16"/></geometry></collision>
      <xacro:box_inertia mass="0.35" x="0.045" y="0.28" z="0.16"/>
    </link>
    <joint name="display_joint" type="fixed">
      <parent link="sensor_mast_link"/><child link="display_link"/>
      <origin xyz="0.05 0 ${display_z - mast_z}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>
</robot>
