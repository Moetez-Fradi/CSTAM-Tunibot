<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="cstam_base"
               params="chassis_length chassis_width chassis_height base_clearance chassis_mass wheel_radius wheel_width wheel_y wheel_front_x wheel_rear_x wheel_mass">
    <link name="base_footprint"/>
    <joint name="base_footprint_joint" type="fixed">
      <parent link="base_footprint"/>
      <child link="base_link"/>
      <origin xyz="0 0 ${chassis_height / 2.0 + base_clearance}" rpy="0 0 0"/>
    </joint>

    <link name="base_link">
      <visual>
        <visibility_flags>2</visibility_flags>
        <geometry><box size="${chassis_length} ${chassis_width} ${chassis_height}"/></geometry>
        <material name="cstam_blue"/>
      </visual>
      <collision name="base_link_collision">
        <geometry><box size="${chassis_length} ${chassis_width} ${chassis_height}"/></geometry>
      </collision>
      <xacro:box_inertia mass="${chassis_mass}" x="${chassis_length}" y="${chassis_width}" z="${chassis_height}"/>
    </link>

    <xacro:cstam_drivetrain
      chassis_height="${chassis_height}"
      wheel_radius="${wheel_radius}"
      wheel_width="${wheel_width}"
      base_clearance="${base_clearance}"
      wheel_y="${wheel_y}"
      wheel_front_x="${wheel_front_x}"
      wheel_rear_x="${wheel_rear_x}"
      wheel_mass="${wheel_mass}"/>
  </xacro:macro>
</robot>
