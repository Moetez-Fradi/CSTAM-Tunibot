<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="cstam_gazebo" params="wheel_radius effective_wheel_separation max_linear_speed">
    <gazebo reference="base_link">
      <material>Gazebo/Blue</material>
      <sensor name="base_contact" type="contact">
        <always_on>true</always_on>
        <update_rate>50</update_rate>
        <topic>/cstam/contacts/base</topic>
        <!-- SDFormat conversion lumps the fixed base joint and renames the
             collision. Contact sensors must reference the converted name. -->
        <contact>
          <collision>base_footprint_fixed_joint_lump__base_link_collision_collision</collision>
          <collision>base_footprint_fixed_joint_lump__front_center_ultrasonic_link_collision_1</collision>
          <collision>base_footprint_fixed_joint_lump__front_left_ultrasonic_link_collision_2</collision>
          <collision>base_footprint_fixed_joint_lump__front_right_ultrasonic_link_collision_3</collision>
          <collision>base_footprint_fixed_joint_lump__left_shelf_support_link_collision_4</collision>
          <collision>base_footprint_fixed_joint_lump__lidar_3d_link_collision_5</collision>
          <collision>base_footprint_fixed_joint_lump__lidar_mount_link_collision_6</collision>
          <collision>base_footprint_fixed_joint_lump__lidar_link_collision_7</collision>
          <collision>base_footprint_fixed_joint_lump__rear_center_ultrasonic_link_collision_8</collision>
          <collision>base_footprint_fixed_joint_lump__rear_left_ultrasonic_link_collision_9</collision>
          <collision>base_footprint_fixed_joint_lump__rear_panel_link_collision_10</collision>
          <collision>base_footprint_fixed_joint_lump__shelf_1_link_collision_11</collision>
          <collision>base_footprint_fixed_joint_lump__shelf_2_link_collision_12</collision>
          <collision>base_footprint_fixed_joint_lump__shelf_3_link_collision_13</collision>
          <collision>base_footprint_fixed_joint_lump__rear_right_ultrasonic_link_collision_14</collision>
          <collision>base_footprint_fixed_joint_lump__right_shelf_support_link_collision_15</collision>
          <collision>base_footprint_fixed_joint_lump__sensor_mast_link_collision_16</collision>
          <collision>base_footprint_fixed_joint_lump__camera_link_collision_17</collision>
          <collision>base_footprint_fixed_joint_lump__display_link_collision_18</collision>
        </contact>
      </sensor>
    </gazebo>

    <gazebo reference="left_front_wheel_link">
      <mu1>1.0</mu1><mu2>1.0</mu2><fdir1>1 0 0</fdir1>
      <kp>1000000.0</kp><kd>10.0</kd><minDepth>0.001</minDepth>
      <material>Gazebo/Black</material>
      <sensor name="left_front_contact" type="contact">
        <always_on>true</always_on><update_rate>50</update_rate>
        <topic>/cstam/contacts/left_front</topic>
        <contact><collision>left_front_wheel_link_fixed_joint_lump__left_front_wheel_collision_collision</collision></contact>
      </sensor>
    </gazebo>
    <gazebo reference="left_rear_wheel_link">
      <mu1>1.0</mu1><mu2>1.0</mu2><fdir1>1 0 0</fdir1>
      <kp>1000000.0</kp><kd>10.0</kd><minDepth>0.001</minDepth>
      <material>Gazebo/Black</material>
      <sensor name="left_rear_contact" type="contact">
        <always_on>true</always_on><update_rate>50</update_rate>
        <topic>/cstam/contacts/left_rear</topic>
        <contact><collision>left_rear_wheel_link_fixed_joint_lump__left_rear_wheel_collision_collision</collision></contact>
      </sensor>
    </gazebo>
    <gazebo reference="right_front_wheel_link">
      <mu1>1.0</mu1><mu2>1.0</mu2><fdir1>1 0 0</fdir1>
      <kp>1000000.0</kp><kd>10.0</kd><minDepth>0.001</minDepth>
      <material>Gazebo/Black</material>
      <sensor name="right_front_contact" type="contact">
        <always_on>true</always_on><update_rate>50</update_rate>
        <topic>/cstam/contacts/right_front</topic>
        <contact><collision>right_front_wheel_link_fixed_joint_lump__right_front_wheel_collision_collision</collision></contact>
      </sensor>
    </gazebo>
    <gazebo reference="right_rear_wheel_link">
      <mu1>1.0</mu1><mu2>1.0</mu2><fdir1>1 0 0</fdir1>
      <kp>1000000.0</kp><kd>10.0</kd><minDepth>0.001</minDepth>
      <material>Gazebo/Black</material>
      <sensor name="right_rear_contact" type="contact">
        <always_on>true</always_on><update_rate>50</update_rate>
        <topic>/cstam/contacts/right_rear</topic>
        <contact><collision>right_rear_wheel_link_fixed_joint_lump__right_rear_wheel_collision_collision</collision></contact>
      </sensor>
    </gazebo>

    <!-- The legacy low and upper 2D LiDAR definitions are intentionally not
         instantiated.  Their links and scan_self_filter remain available for
         debugging, while the accepted Phase 1 runtime uses only cstam_3d_lidar. -->

    <!-- One primary simulated 3D LiDAR.  Gazebo publishes a real
         PointCloudPacked side topic at /lidar/points. -->
    <gazebo reference="lidar_3d_link">
      <sensor name="cstam_3d_lidar" type="gpu_lidar">
        <always_on>true</always_on>
        <visualize>true</visualize>
        <update_rate>8</update_rate>
        <topic>/lidar</topic>
        <gz_frame_id>lidar_3d_link</gz_frame_id>
        <lidar>
          <visibility_mask>1</visibility_mask>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159265</min_angle>
              <max_angle>3.14159265</max_angle>
            </horizontal>
            <vertical>
              <samples>16</samples>
              <resolution>1</resolution>
              <min_angle>-1.04719755</min_angle>
              <max_angle>0.34906585</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.10</min>
            <max>15.0</max>
            <resolution>0.01</resolution>
          </range>
        </lidar>
      </sensor>
    </gazebo>

    <!-- Gazebo Harmonic RGB-D sensor. ROS bridges are started by the test launch. -->
    <gazebo reference="camera_link">
      <sensor name="cstam_rgbd_camera" type="rgbd_camera">
        <always_on>true</always_on>
        <visualize>true</visualize>
        <update_rate>15</update_rate>
        <topic>/camera/rgbd</topic>
        <gz_frame_id>camera_optical_frame</gz_frame_id>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.10</near><far>12.0</far></clip>
        </camera>
      </sensor>
    </gazebo>

    <gazebo>
      <!-- Publish real wheel joint positions for RobotModel/TF visualization. -->
      <plugin filename="gz-sim-joint-state-publisher-system"
              name="gz::sim::systems::JointStatePublisher">
        <topic>/joint_states</topic>
        <joint_name>left_front_wheel_joint</joint_name>
        <joint_name>left_rear_wheel_joint</joint_name>
        <joint_name>right_front_wheel_joint</joint_name>
        <joint_name>right_rear_wheel_joint</joint_name>
      </plugin>
      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>left_front_wheel_joint</left_joint>
        <left_joint>left_rear_wheel_joint</left_joint>
        <right_joint>right_front_wheel_joint</right_joint>
        <right_joint>right_rear_wheel_joint</right_joint>
        <wheel_separation>${effective_wheel_separation}</wheel_separation>
        <wheel_radius>${wheel_radius}</wheel_radius>
        <max_velocity>${max_linear_speed}</max_velocity>
        <max_linear_acceleration>1.0</max_linear_acceleration>
        <min_linear_acceleration>-1.0</min_linear_acceleration>
        <max_angular_acceleration>2.0</max_angular_acceleration>
        <min_angular_acceleration>-2.0</min_angular_acceleration>
        <max_angular_velocity>1.9</max_angular_velocity>
        <min_angular_velocity>-1.9</min_angular_velocity>
        <odom_publish_frequency>30</odom_publish_frequency>
        <topic>/cmd_vel</topic>
        <odom_topic>/odom</odom_topic>
        <tf_topic>/tf</tf_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>base_drive</child_frame_id>
      </plugin>
    </gazebo>
  </xacro:macro>
</robot>
