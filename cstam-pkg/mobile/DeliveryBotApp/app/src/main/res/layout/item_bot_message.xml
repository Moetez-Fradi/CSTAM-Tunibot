<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="start"
    android:padding="8dp">

    <!-- Bot Icon -->
    <ImageView
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/ic_robot"
        android:padding="4dp"
        android:background="@drawable/bg_circle_dark"
        android:layout_marginEnd="8dp" 
        android:contentDescription="Bot Icon"/>

    <!-- Bot Message Bubble -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="48dp"
        android:background="@drawable/bg_neon_bot"
        android:orientation="vertical"
        android:padding="12dp"
        android:elevation="2dp">
        android:orientation="vertical"
        android:padding="12dp"
        android:elevation="2dp">

        <!-- Bot Message Text -->
        <TextView
            android:id="@+id/textBotMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bot message here"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:lineSpacingExtra="2dp"
            android:maxWidth="280dp" />

        <!-- Bot Image Snapshot -->
        <ImageView
            android:id="@+id/imageBotSnapshot"
            android:layout_width="200dp"
            android:layout_height="150dp"
            android:layout_marginTop="8dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_image_placeholder"
            android:visibility="gone"
            android:background="@drawable/rounded_image_bg" 
            android:clipToOutline="true" />

        <!-- Timestamp -->
        <TextView
            android:id="@+id/textBotTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12:30 PM"
            android:textColor="#B39DDB"
            android:textSize="10sp"
            android:layout_marginTop="4dp"
            android:gravity="start" />

    </LinearLayout>

</LinearLayout>