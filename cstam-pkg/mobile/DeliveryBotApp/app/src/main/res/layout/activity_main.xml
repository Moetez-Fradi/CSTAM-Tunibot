<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg_dark">

    <!-- ========== 1. TOP BAR ========== -->
    <LinearLayout android:id="@+id/topBar" android:layout_width="match_parent" android:layout_height="60dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:background="@color/bg_dark" app:layout_constraintTop_toTopOf="parent">

        <!-- Connect Button (Left) - Red Plug -->
        <ImageButton android:id="@+id/btnConnect" android:layout_width="36dp" android:layout_height="36dp" android:src="@drawable/ic_connect" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="Connect" android:scaleType="fitCenter"/>

        <!-- App Title + Status (Center) -->
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:layout_marginHorizontal="12dp">

            <TextView android:id="@+id/txtAppTitle" android:text="Delivery Bot" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>

            <TextView android:id="@+id/txtStatus" android:text="🔴 Offline | 10.42.0.1" android:textColor="@color/text_secondary" android:textSize="11sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- Settings Button (Right) - Gear -->
        <ImageButton android:id="@+id/btnSettings" android:layout_width="36dp" android:layout_height="36dp" android:src="@drawable/ic_settings_gear" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="Settings" android:scaleType="fitCenter"/>
    </LinearLayout>

    <!-- ========== 2. SWIPE HINT ========== -->
    <TextView android:id="@+id/lblSwipeHint" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dashboard (Swipe → Camera)" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginStart="16dp" android:layout_marginTop="8dp" app:layout_constraintTop_toBottomOf="@id/topBar" app:layout_constraintStart_toStartOf="parent"/>

    <!-- ========== 3. LIVE VIEW (Video + Dashboard Swipeable) ========== -->
    <androidx.viewpager2.widget.ViewPager2 android:id="@+id/viewPager" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="4dp" android:layout_marginHorizontal="16dp" android:background="@drawable/bg_video_container" app:layout_constraintTop_toBottomOf="@id/lblSwipeHint" app:layout_constraintBottom_toTopOf="@id/gridContainer" app:layout_constraintHeight_percent="0.30"/>

    <!-- ========== 4. CONTROL GRID (2x2) ========== -->
    <LinearLayout android:id="@+id/gridContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" app:layout_constraintBottom_toTopOf="@id/btnCreateOrder">

        <!-- Row 1 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="12dp">

            <!-- Open Map Card -->
            <LinearLayout android:id="@+id/cardOpenMap" android:layout_width="0dp" android:layout_height="110dp" android:layout_weight="1" android:layout_marginEnd="8dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/bg_card_cyan" android:clickable="true" android:focusable="true">

                <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_map_flag" android:contentDescription="Map Icon"/>

                <TextView android:text="Open Map" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold" android:layout_marginTop="10dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- Dashboard Card -->
            <LinearLayout android:id="@+id/cardDashboard" android:layout_width="0dp" android:layout_height="110dp" android:layout_weight="1" android:layout_marginStart="8dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/bg_card_purple" android:clickable="true" android:focusable="true">

                <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_dashboard_grid" android:contentDescription="Dashboard Icon"/>

                <TextView android:text="Dashboard" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold" android:layout_marginTop="10dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Row 2 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">

            <!-- AI Chatbot Card -->
            <LinearLayout android:id="@+id/cardChatbot" android:layout_width="0dp" android:layout_height="110dp" android:layout_weight="1" android:layout_marginEnd="8dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/bg_card_pink" android:clickable="true" android:focusable="true">

                <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_robot" android:contentDescription="Chatbot Icon"/>

                <TextView android:text="AI Chatbot" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold" android:layout_marginTop="10dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- Manual Control Card -->
            <LinearLayout android:id="@+id/cardManualControl" android:layout_width="0dp" android:layout_height="110dp" android:layout_weight="1" android:layout_marginStart="8dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/bg_card_orange" android:clickable="true" android:focusable="true">

                <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_gamepad" android:contentDescription="Manual Control Icon"/>

                <TextView android:text="Manual Control" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold" android:layout_marginTop="10dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ========== 5. PRIMARY ACTION BUTTON ========== -->
    <Button android:id="@+id/btnCreateOrder" android:text="Create New Order 📦" android:textColor="@android:color/white" android:textSize="16sp" android:textStyle="bold" android:textAllCaps="false" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginHorizontal="16dp" android:layout_marginBottom="20dp" android:background="@drawable/bg_btn_primary_blue" app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>