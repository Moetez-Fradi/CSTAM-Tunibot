<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Title -->
    <TextView
        android:id="@+id/tvTitle"
        android:text="Manual Control"
        android:textStyle="bold"
        android:textColor="#00D9FF"
        android:textSize="24sp"
        android:gravity="center"
        android:paddingVertical="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- Video Container - Bigger -->
    <FrameLayout
        android:id="@+id/videoContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_video_live"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintBottom_toTopOf="@id/commandSection"
        app:layout_constraintHeight_percent="0.30">

        <!-- Fragment container for video - same as main screen -->
        <FrameLayout
            android:id="@+id/videoFragmentContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible"/>

        <!-- WebView fallback (hidden) -->
        <WebView
            android:id="@+id/videoWebView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"/>

        <!-- LIVE Badge -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="10dp"
            android:background="#DD000000"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:orientation="horizontal">

            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="6dp"
                android:background="@android:color/holo_red_light"/>

            <TextView
                android:text="LIVE"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </FrameLayout>

    <!-- Command Section - Vertical (bottom to top) -->
    <LinearLayout
        android:id="@+id/commandSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/videoContainer">

        <TextView
            android:id="@+id/tvCommand2"
            android:text=""
            android:textColor="#00D9FF"
            android:textSize="11sp"
            android:background="@drawable/bg_card_dark"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:layout_marginBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/tvCommand1"
            android:text=""
            android:textColor="#00D9FF"
            android:textSize="11sp"
            android:background="@drawable/bg_card_dark"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>

    <!-- Input Row -->
    <LinearLayout
        android:id="@+id/inputSection"
        android:layout_marginTop="10dp"
        android:layout_marginHorizontal="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/commandSection">

        <EditText
            android:id="@+id/messageInput"
            android:hint="Voice command..."
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:background="@drawable/edit_field_bg"
            android:paddingHorizontal="14dp"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="48dp" />

        <ImageButton
            android:id="@+id/btnVoice"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_control_button_cyan"
            android:src="@drawable/ic_mic"
            android:tint="#00D9FF"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:contentDescription="Voice Input" />

        <ImageButton
            android:id="@+id/btnSend"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/btn_cyan"
            android:src="@android:drawable/ic_menu_send"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:contentDescription="Send" />
    </LinearLayout>

    <!-- Control Panel - Center -->
    <LinearLayout
        android:id="@+id/controlPanel"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/inputSection"
        app:layout_constraintBottom_toTopOf="@id/speedSection">

        <!-- Direction Buttons - Bigger with better spacing -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <!-- Up Button -->
            <ImageButton
                android:id="@+id/btnUp"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_control_button_cyan"
                android:src="@android:drawable/arrow_up_float"
                android:scaleType="centerInside"
                android:contentDescription="Up"/>

            <!-- Middle Row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <ImageButton
                    android:id="@+id/btnLeft"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_marginEnd="20dp"
                    android:background="@drawable/bg_control_button_cyan"
                    android:src="@android:drawable/ic_media_previous"
                    android:scaleType="centerInside"
                    android:contentDescription="Left"/>

                <ImageButton
                    android:id="@+id/btnStop"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="@drawable/bg_control_button_stop"
                    android:src="@android:drawable/ic_media_pause"
                    android:scaleType="centerInside"
                    android:contentDescription="Stop"/>

                <ImageButton
                    android:id="@+id/btnRight"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_marginStart="20dp"
                    android:background="@drawable/bg_control_button_cyan"
                    android:src="@android:drawable/ic_media_next"
                    android:scaleType="centerInside"
                    android:contentDescription="Right"/>
            </LinearLayout>

            <!-- Down Button -->
            <ImageButton
                android:id="@+id/btnDown"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_control_button_cyan"
                android:src="@android:drawable/arrow_down_float"
                android:scaleType="centerInside"
                android:contentDescription="Down"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Speed Section - Bottom -->
    <LinearLayout
        android:id="@+id/speedSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingVertical="16dp"
        android:paddingHorizontal="24dp"
        android:background="#0D1117"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/speedText"
            android:text="Speed: 0.5"
            android:textColor="#00D9FF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <SeekBar
            android:id="@+id/seekBarSpeed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:max="100"
            android:progress="50"
            android:progressTint="#00D9FF"
            android:thumbTint="#00D9FF"
            android:progressBackgroundTint="#333333"/>
    </LinearLayout>

    <!-- Hidden elements for compatibility -->
    <ScrollView
        android:id="@+id/logScroll"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:id="@+id/logText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </ScrollView>

    <Button
        android:id="@+id/btnTogglePanel"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"/>

    <include
        android:id="@+id/panelInclude"
        layout="@layout/include_control_panel"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
